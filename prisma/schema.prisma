generator client {
    provider   = "prisma-client-js"
    engineType = "library"
}

datasource db {
    provider = "postgresql"
}

model User {
    id               String    @id @default(cuid())
    email            String    @unique
    name             String?
    mobile           String?   @unique
    isMobileVerified Boolean   @default(false)
    acceptedTerms    Boolean   @default(false)
    image            String?
    password         String
    planType         String    @default("free")
    level            Int       @default(1)
    xp               Int       @default(0)
    coins            Int       @default(0)
    streak           Int       @default(0)
    bestStreak       Int       @default(0)
    totalStudyDays   Int       @default(0)
    lastActivityDate DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    // Referral fields
    referralCode     String?   @unique
    referralCount    Int       @default(0)
    referralCoupons  Coupon[]  @relation("ReferrerCoupon")
    referredBy       String?

    // Relations
    answers         MCQAnswer[]
    progress        UserProgress[]
    bookmarks       Bookmark[]
    testSubmissions TestSubmission[]
    notifications   Notification[]
    devices         Device[]
    loginHistory    LoginHistory[]
    paymentHistory  PaymentHistory[]
    whatsappLogs    WhatsappLog[]
    liveExams       LiveExamParticipant[]
    challengeParticipants ChallengeParticipant[]
    challengeDisputes ChallengeDispute[]

    examId          String?
    exam            Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
}

model Plan {
    id            String   @id @default(cuid())
    name          String   @unique
    price         Int
    discountPrice Int?
    description   String?
    features      String[]
    isPopular     Boolean  @default(false)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

// ─── Exam Hierarchy ───────────────────────────────────────────────────────────

model Exam {
    id          String    @id @default(cuid())
    name        String    @unique
    description String?
    isActive    Boolean   @default(true)
    subjects    Subject[]
    mockTests   MockTest[]
    users       User[]
    payments    PaymentHistory[]
    coupons     Coupon[]
    admins      Admin[]   @relation("AdminExams")
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model Subject {
    id           String   @id @default(cuid())
    name         String
    icon         String?
    part         String   @default("A")
    sortOrder    Int      @default(0)
    isFree       Boolean  @default(false)
    isActive     Boolean  @default(true)
    isComingSoon Boolean  @default(false)
    examId       String
    exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
    topics       Topic[]
    notes        Note[]
    challengeRules ChallengeRule[]
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([name, examId])
}

model Topic {
    id        String  @id @default(cuid())
    name      String
    subtopics String
    weight    String
    subjectId String
    sortOrder Int     @default(0)
    isActive  Boolean @default(true)

    subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    mcqs      MCQ[]
    images    UploadedImage[]
    challengeRules ChallengeRule[]
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    @@unique([name, subjectId])
}

model MCQ {
    id            String      @id @default(cuid())
    no            Int?
    question      String
    optionA       String
    optionB       String
    optionC       String
    optionD       String
    correctAnswer String
    explanation   String?
    imageUrl      String?
    difficulty    String      @default("Medium")
    isPyq         Boolean     @default(false)
    language      String      @default("English")
    translationId String?
    topicId       String
    topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
    answers       MCQAnswer[]
    bookmarks     Bookmark[]
    challengeQuestions ChallengeQuestion[]
    challengeDisputes  ChallengeDispute[]
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    @@index([difficulty])
}

model MCQAnswer {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mcqId     String
    mcq       MCQ      @relation(fields: [mcqId], references: [id], onDelete: Cascade)
    answer    String
    isCorrect Boolean
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, mcqId])
}

model UserProgress {
    id            String   @id @default(cuid())
    userId        String
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    subjectId     String
    correctCount  Int      @default(0)
    totalAttempts Int      @default(0)
    accuracy      Float    @default(0)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

enum AdminRole {
    SUPER_ADMIN
    EXAM_ADMIN
}

model Admin {
    id        Int       @id @default(autoincrement())
    email     String    @unique
    password  String // bcrypt hash
    name      String?
    image     String?
    instagram String?
    facebook  String?
    twitter   String?
    youtube   String?
    role      AdminRole @default(SUPER_ADMIN)
    exams     Exam[]    @relation("AdminExams")
    createdAt DateTime  @default(now())
}

model PracticeMcq {
    id            String   @id @default(cuid())
    subject       String
    topic         String
    difficulty    String   @default("Medium")
    question      String
    optionA       String
    optionB       String
    optionC       String
    optionD       String
    correctAnswer String
    explanation   String?
    imageUrl      String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([subject, topic, difficulty])
    @@index([topic])
}

model MockTest {
    id              String             @id @default(cuid())
    title           String             @unique
    description     String?
    durationMinutes Int?
    csvFilename     String?
    totalQuestions  Int                @default(0)
    failedRows      Int                @default(0)
    uploadStatus    String             @default("draft")
    isActive        Boolean            @default(true)
    isComingSoon    Boolean            @default(false)
    planType        String             @default("free")
    testType        String             @default("Mix")
    questions       MockTestQuestion[]
    images          UploadedImage[]
    liveExams       LiveExam[]
    examId          String?
    exam            Exam?              @relation(fields: [examId], references: [id], onDelete: SetNull)
    createdAt       DateTime           @default(now())
    updatedAt       DateTime           @updatedAt
}

model MockTestQuestion {
    id            String   @id @default(cuid())
    mockTestId    String
    mockTest      MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
    no            Int?
    question      String
    optionA       String
    optionB       String
    optionC       String
    optionD       String
    correctAnswer String
    explanation   String?
    imageUrl      String?
    difficulty    String   @default("Medium")
    language      String   @default("English")
    translationId String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([mockTestId])
}

model CSVUpload {
    id        Int      @id @default(autoincrement())
    filename  String
    questions Int
    failed    Int      @default(0)
    status    String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model UploadedImage {
    id         String    @id @default(cuid())
    filename   String
    url        String
    topicId    String?
    topic      Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)
    mockTestId String?
    mockTest   MockTest? @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
    createdAt  DateTime  @default(now())

    @@index([topicId])
    @@index([mockTestId])
}

model Bookmark {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mcqId     String
    mcq       MCQ      @relation(fields: [mcqId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, mcqId])
}

model TestSubmission {
    id          String   @id @default(cuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    title       String
    mode        String
    totalMarks  Int
    earnedMarks Float
    percentage  Float
    details     Json?
    xpEarned    Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model ContactMessage {
    id        String   @id @default(cuid())
    name      String
    email     String
    subject   String?
    message   String
    status    String   @default("UNREAD")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Notification {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    title     String
    message   String
    type      String // e.g., "XP", "STREAK", "LEVEL_UP"
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())
}

model Device {
    id         String   @id @default(cuid())
    deviceId   String   @unique
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    browser    String?
    os         String?
    deviceType String?
    screen     String?
    timezone   String?
    language   String?
    firstLogin DateTime @default(now())
    lastLogin  DateTime @updatedAt
    lastIp     String?

    @@index([userId])
}

model LoginHistory {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceId  String?
    ip        String?
    status    String
    browser   String?
    os        String?
    createdAt DateTime @default(now())

    @@index([userId])
}

model Coupon {
    id              String    @id @default(cuid())
    code            String    @unique
    discountPercent Int
    isActive        Boolean   @default(true)
    expiresAt       DateTime?
    maxUses         Int?
    usedCount       Int       @default(0)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    examId          String?
    exam            Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)

    referrerId      String?
    referrerUser    User?     @relation("ReferrerCoupon", fields: [referrerId], references: [id], onDelete: SetNull)

    payments PaymentHistory[]
}

model PaymentHistory {
    id                String   @id @default(cuid())
    userId            String
    user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    planId            String
    amount            Int
    couponId          String?
    coupon            Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
    razorpayOrderId   String?
    razorpayPaymentId String?
    status            String   @default("PENDING") // PENDING, SUCCESS, FAILED
    examId            String?
    exam              Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([userId])
}

model WhatsappLog {
    id           String   @id @default(cuid())
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mobile       String
    templateName String
    status       String   @default("SUCCESS") // SUCCESS, FAILED
    response     Json?
    createdAt    DateTime @default(now())

    @@index([userId])
}

model Note {
    id                   String        @id @default(cuid())
    title                String
    pdfUrl               String
    subjectId            String
    subject              Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    sortOrder            Int           @default(0)
    isActive             Boolean       @default(true)
    estimatedTimeMinutes Int?          @default(60)
    totalPages           Int?          @default(0)
    isFree               Boolean       @default(false)
    sections             NoteSection[]
    createdAt            DateTime      @default(now())
    updatedAt            DateTime      @updatedAt

    @@index([subjectId])
}

model NoteSection {
    id         String   @id @default(cuid())
    title      String
    pageNumber Int?
    sortOrder  Int      @default(0)
    noteId     String
    note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([noteId])
}

model LiveExam {
    id          String   @id @default(cuid())
    title       String
    description String?
    mockTestId  String   
    mockTest    MockTest @relation(fields: [mockTestId], references: [id])
    startTime   DateTime
    endTime     DateTime // startTime + 1 hour
    participants LiveExamParticipant[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model LiveExamParticipant {
    id          String   @id @default(cuid())
    liveExamId  String
    liveExam    LiveExam @relation(fields: [liveExamId], references: [id], onDelete: Cascade)
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    score       Int      @default(0)
    totalMarks  Int      @default(0)
    answers     Json?    // Store user answers e.g. {"questionId": "optionA"}
    submittedAt DateTime?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([liveExamId, userId])
}

// ─── Detective Challenges ────────────────────────────────────────────────────────

model Challenge {
    id              String   @id @default(cuid())
    title           String
    durationMinutes Int
    status          String   @default("DRAFT") // DRAFT, LIVE, ENDED
    targetExamTag   String?
    scheduledDate   DateTime?
    endDate         DateTime?
    maxUsers        Int?
    maxAttempts     Int?
    
    rules           ChallengeRule[]
    questions       ChallengeQuestion[]
    participants    ChallengeParticipant[]
    disputes        ChallengeDispute[]

    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

model ChallengeRule {
    id          String    @id @default(cuid())
    challengeId String
    challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
    subjectId   String?
    subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
    topicId     String?
    topic       Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
    qty         Int
    
    createdAt   DateTime  @default(now())
}

model ChallengeQuestion {
    id          String    @id @default(cuid())
    challengeId String
    challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
    mcqId       String
    mcq         MCQ       @relation(fields: [mcqId], references: [id], onDelete: Cascade)
    
    createdAt   DateTime  @default(now())

    @@unique([challengeId, mcqId])
}

model ChallengeParticipant {
    id          String    @id @default(cuid())
    challengeId String
    challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    score       Float     @default(0)
    xpEarned    Int       @default(0)
    answers     Json?     // User answers
    status      String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
    submittedAt DateTime?
    
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@unique([challengeId, userId])
}

model ChallengeDispute {
    id          String    @id @default(cuid())
    challengeId String
    challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
    mcqId       String
    mcq         MCQ       @relation(fields: [mcqId], references: [id], onDelete: Cascade)
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    suggestedKey String
    reason       String?
    status       String    @default("PENDING") // PENDING, ACCEPTED, REJECTED
    
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@unique([challengeId, mcqId])
}

